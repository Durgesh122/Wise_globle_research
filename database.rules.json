{
  "rules": {
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "chatbot-submissions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": true,
      ".indexOn": ["timestamp"]
    },
     "homeFormSubmissions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "newData.exists() && newData.child('timestamp').isNumber() && newData.child('email').isString() && (!newData.child('honeypot').exists() || newData.child('honeypot').val() == '')"
      },
      ".indexOn": ["timestamp"]
    },
    "popoForms": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "newData.exists() && newData.child('timestamp').isString() && newData.child('city').isString() && newData.child('interest').isString() && (!newData.child('honeypot').exists() || newData.child('honeypot').val() == '')"
      },
      ".indexOn": ["timestamp"]
    },
    "complaints": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },
    "clientServiceConsentForms": {
      ".write": "true",
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["timestamp"]
    },
    "complaintTableData": {
      ".read": "true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "monthlyDisposalTableData": {
  ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "annualDisposalTableData": {
  ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "reports": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}