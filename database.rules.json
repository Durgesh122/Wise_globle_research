{
  "rules": {
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "homeFormSubmissions": {
      ".write": true,
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": "timestamp"
    },
    "popoForms": {
      ".read": true,
      ".write": true,
      ".indexOn": "timestamp"
    },
    "complaints": {
      ".read": true,
      ".write": true,
      ".indexOn": "timestamp"
    },
    "clientServiceConsentForms": {
      ".write": true,
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": "timestamp"
    },
    "complaintTableData": {
      ".read": true,
      ".write": true
    },
    "reports": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    ".read": false,
    ".write": false
  }
}
